{
  "cli": {
    "version": ">= 24.12.1",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://dev.salmonbus.com"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://www.salmonbus.com"
      }
    },
    "production-simulator": {
      "extends": "production",
      "ios": {
        "simulator": true
      }
    },
    "dev-testflight": {
      "extends": "production",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_WEB_URL": "https://dev.salmonbus.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6827973564"
      }
    }
  }
}
