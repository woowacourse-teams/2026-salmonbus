EXPO_PUBLIC_WEB_URL=
# NAVER Cloud Platform: enable Dynamic Map and register com.salmonbus.app.
# This is a public client key ID, not the server-side client secret.
NAVER_MAP_KEY_ID=
# Kakao Developers: the native app key of the Kakao app that web login uses (dev and production differ).
# Without it the app cannot sign in with Kakao natively and the web falls back to WebView login.
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=
