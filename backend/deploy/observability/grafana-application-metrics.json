    {
      "id": 6,
      "title": "API 5xx 비율",
      "description": "실제 처리된 HTTP 요청 중 5xx 비율. 무요청은 0%가 아니라 표본 없음. 프로세스에 도달하지 못한 실패는 외부 probe가 필요합니다.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 6,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{job=\"salmonbus/api\",uri!~\"/actuator.*|/readyz|/livez\",status=~\"5..\"}[5m])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"salmonbus/api\",uri!~\"/actuator.*|/readyz|/livez\"}[5m])))) / sum(rate(http_server_requests_seconds_count{job=\"salmonbus/api\",uri!~\"/actuator.*|/readyz|/livez\"}[5m])))",
          "legendFormat": "{{job}} · {{instance}}",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "미수집 / 표본 없음",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
