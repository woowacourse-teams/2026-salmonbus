          }
        }
      ]
    },
    {
      "id": 11,
      "title": "정산 완료분 중 좌석 평가 가능 비율",
      "type": "table",
      "description": "전체 발행 예보의 평가 커버리지가 아니다. Writer가 전달한 완료분만 분모이며 PENDING 및 별도 일괄 품질 제외는 포함하지 않는다.",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (routeId,routeVersionId,stopOrder,routeName,stopName,stopId,direction,modelDeploymentId,distance) (sum_over_time({unit=\"salmonbus-worker.service\"} |= \"event=forecast_accuracy \" | logfmt | routeName=~\"${route:raw}\" | stopName=~\"${stop:raw}\" | distance=~\"${distance:raw}\" | modelDeploymentId=~\"${model:raw}\" | unwrap maeCount | __error__=\"\" [$__range])) / (sum by (routeId,routeVersionId,stopOrder,routeName,stopName,stopId,direction,modelDeploymentId,distance) (sum_over_time({unit=\"salmonbus-worker.service\"} |= \"event=forecast_accuracy \" | logfmt | routeName=~\"${route:raw}\" | stopName=~\"${stop:raw}\" | distance=~\"${distance:raw}\" | modelDeploymentId=~\"${model:raw}\" | unwrap completed | __error__=\"\" [$__range])) > 0)",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "instant": true,
          "range": false,
          "legendFormat": "{{operation}} {{outcome}}",
          "queryType": "instant",
          "maxLines": 100,
          "direction": "backward",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "routeName"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "노선 번호"
              }
            ]
