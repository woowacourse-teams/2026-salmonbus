    {
      "id": 505,
      "title": "현재 회원 수",
      "description": "운영 DB를 5분마다 한 번 집계한 표본입니다. 여러 API 인스턴스의 같은 값을 더하지 않고 max로 봅니다.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 353,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "max(salmonbus_users_current{job=\"salmonbus/api\"} >= 0)",
          "legendFormat": "회원",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "미수집 / 표본 없음"
