# 원격에 이 예시를 그대로 적용하지 않는다. DB와 S3 권한을 별도 설정한다.
DB_URL=jdbc:postgresql://<host>:5432/<database>
DB_USERNAME=<archive-user>
DB_PASSWORD=<secret>
ARCHIVE_ENABLED=false
ARCHIVE_DELETE_ENABLED=false
ARCHIVE_BUCKET=techcourse-project-2026
ARCHIVE_PREFIX=salmonbus/prod/lake-v2/
ARCHIVE_PAGE_SIZE=2000
ARCHIVE_READ_TIMEOUT=120s
ARCHIVE_PURGE_PAUSE=0s
ARCHIVE_PARTITION_EXPORT_ENABLED=false
ARCHIVE_PARTITION_EXPORT_DROP_ENABLED=false
ARCHIVE_PARTITION_EXPORT_RETENTION_DAYS=3
ARCHIVE_PARTITION_EXPORT_PREFIX=salmonbus/prod/lake-v3/
ARCHIVE_PARTITION_EXPORT_INTERVAL=1h
ARCHIVE_PARTITION_EXPORT_PAGE_SIZE=2000
ARCHIVE_PARTITION_EXPORT_LOCK_TIMEOUT=2s
