      "updated": 1793282114783,
      "link": null,
      "locked": false,
      "text": "연결이 끊겼다가 돌아오면?",
      "fontSize": 26,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "연결이 끊겼다가 돌아오면?",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e22",
      "type": "text",
      "x": 60,
      "y": 995,
      "width": 635.352,
      "height": 90,
      "angle": 0,
      "strokeColor": "#000000",
