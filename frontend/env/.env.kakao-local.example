# 같은 카카오 개발앱의 값 세 개를 입력합니다.
# CLIENT_ID는 숫자 앱 ID가 아니라 REST API 키 전체 값입니다. Native 앱 키나 JavaScript 키도 아닙니다.
AUTH_KAKAO_CLIENT_ID=
AUTH_KAKAO_CLIENT_SECRET=
# 현재 백엔드는 연결 해제용 Admin Key도 기동 시 검증합니다.
AUTH_KAKAO_ADMIN_KEY=

# 아래 두 값은 로컬 전용으로 생성합니다. 운영 서버의 서명키를 사용하지 않습니다.
AUTH_TOKEN_SECRET=
AUTH_REFRESH_TOKEN_SECRET=
