                {
                  "type": "text",
                  "id": "MrYid",
                  "x": 505,
                  "y": 254,
                  "name": "레이아웃 타이포 토큰 표",
                  "fill": "$roe-v2-text-secondary",
                  "textGrowth": "fixed-width",
                  "width": 430,
                  "content": "Font family\n--text-font-ui             'Noto Sans KR'\n--text-font-number         Inter\n\nEntry\n--text-entry-title         28px / 800 / 1.25 / -0.2px\n--text-route-card-number   30px / 900 / normal\n--text-route-card-name     17px / 600 / normal\n--text-entry-description   13.5px / 500 / 1.55\n\nForecast board\n--text-route-number        21px / 600 / normal / -0.6px\n--text-station-name        15.5px / 600 / 1.35 / -0.25px\n--text-probability-label   11.5px / 600 / normal / -0.15px\n--text-arrival             13.5px / 600 / normal\n--text-waypoint-name       13px / 500 / 1.3 / -0.25px\n--text-waypoint-caption    10.5px / 500 / normal / -0.15px\n--text-seat-current-label  7px / 600 / 1.1\n--text-seat-current-value  11.5px / 900 / 1.1\n\nError\n--text-error-title         25px / 900 / 1.25 / -0.5px\n--text-error-description   14px / 500 / 1.55\n--text-action-label        15px / 900 / normal\n\nSystem\n--text-status-bar          14px / 700 / Inter",
                  "lineHeight": 1.55,
                  "fontFamily": "Roboto Mono",
                  "fontSize": 10.8,
                  "fontWeight": "normal"
                },
                {
                  "type": "frame",
                  "id": "J6ni2",
                  "x": 970,
                  "y": 250,
                  "name": "CSS 변수 코드 블록",
                  "width": 470,
                  "height": 920,
                  "fill": "#171717",
                  "cornerRadius": 10,
                  "layout": "vertical",
                  "padding": 24,
                  "children": [
                    {
                      "type": "text",
                      "id": "GHfHl",
                      "name": "CSS 변수 코드",
                      "fill": "#F7F7F5",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": ":root {\n  --color-surface-default: #fff;\n  --color-surface-subtle: #f7f7f5;\n  --color-surface-error: #f8fafc;\n  --color-text-primary: #171b22;\n  --color-text-station: #151515;\n  --color-text-secondary: #454545;\n  --color-text-muted: #6b7280;\n  --color-text-entry-muted: #66635e;\n  --color-text-current-muted: #6b6a6a;\n  --color-action-selected: #111;\n  --color-selection-border: #171717;\n  --color-border-default: #d8d5cf;\n  --color-border-action: #dfe3e8;\n  --color-border-subtle: #e3e2de;\n  --color-divider: #e2dfd8;\n  --color-route-line: #b8b4ac;\n  --color-icon-muted: #8a8781;\n  --color-waypoint-bg: #f7f8fa;\n  --color-waypoint-text: #5b6472;\n  --color-waypoint-divider: #e3e6ea;\n  --color-waypoint-muted: #aab2bc;\n  --color-live-bus: #c93b32;\n  --color-action-accent: #e53d4d;\n  --color-black: #000;\n  --color-transparent: #fff0;\n  --color-probability-high-fill: #dce8de;\n  --color-probability-high-stroke: #6f9276;\n  --color-probability-high-text: #31573a;\n  --color-probability-low-fill: #eee6c9;\n  --color-probability-low-stroke: #c3a34c;\n  --color-probability-low-text: #6d5b1d;\n  --color-probability-very-low-fill: #e9d7d5;\n  --color-probability-very-low-stroke: #b9655e;\n  --color-probability-very-low-text: #7d352f;\n  --color-mascot-ink: #242426;\n  --color-mascot-coral: #f58678;\n  --color-mascot-coral-dark: #ee7066;\n  --color-mascot-gray: #e5eced;\n  --color-mascot-blue: #8bd0e7;\n  --color-mascot-pink: #f9d0cb;\n  --color-mascot-pink-soft: #fde0dc;\n\n  --text-font-ui: 'Noto Sans KR', sans-serif;\n  --text-font-number: Inter, sans-serif;\n  --text-entry-title: 800 28px/1.25 var(--text-font-ui);\n  --text-entry-title-tracking: -.2px;\n  --text-route-card-number: 900 30px/normal var(--text-font-ui);\n  --text-route-card-name: 600 17px/normal var(--text-font-ui);\n  --text-entry-description: 500 13.5px/1.55 var(--text-font-ui);\n  --text-route-number: 600 21px/normal var(--text-font-number);\n  --text-route-number-tracking: -.6px;\n  --text-station-name: 600 15.5px/1.35 var(--text-font-ui);\n  --text-station-name-tracking: -.25px;\n  --text-probability: 600 11.5px/normal var(--text-font-ui);\n  --text-probability-tracking: -.15px;\n  --text-arrival: 600 13.5px/normal var(--text-font-ui);\n  --text-waypoint-name: 500 13px/1.3 var(--text-font-ui);\n  --text-waypoint-caption: 500 10.5px/normal var(--text-font-ui);\n  --text-seat-label: 600 7px/1.1 var(--text-font-ui);\n  --text-seat-value: 900 11.5px/1.1 var(--text-font-ui);\n  --text-error-title: 900 25px/1.25 var(--text-font-ui);\n  --text-error-title-tracking: -.5px;\n  --text-error-description: 500 14px/1.55 var(--text-font-ui);\n  --text-action-label: 900 15px/normal var(--text-font-ui);\n  --text-status-bar: 700 14px/normal var(--text-font-number);\n}",
                      "lineHeight": 1.32,
                      "fontFamily": "Roboto Mono",
                      "fontSize": 8.9,
                      "fontWeight": "normal"
                    }
                  ]
                },
