                    {
                      "type": "text",
                      "id": "bv1Nl",
                      "name": "Token contract 코드 블록 코드",
                      "fill": "#F7F7F5",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "import { createGlobalThemeContract } from\n  '@vanilla-extract/css';\n\nexport const tokens = createGlobalThemeContract({\n  color: {\n    surface: { default: null, subtle: null, error: null },\n    text: {\n      primary: null, station: null, secondary: null,\n      muted: null, entryMuted: null, currentMuted: null,\n    },\n    action: { selected: null, accent: null },\n    border: {\n      default: null, action: null, subtle: null, selection: null,\n    },\n    route: { line: null, divider: null },\n    waypoint: { background: null, text: null, divider: null, muted: null },\n    probability: {\n      high: { fill: null, stroke: null, text: null },\n      low: { fill: null, stroke: null, text: null },\n      veryLow: { fill: null, stroke: null, text: null },\n    },\n    live: { bus: null, currentLabel: null },\n    mascot: {\n      ink: null, coral: null, coralDark: null, gray: null,\n      blue: null, pink: null, pinkSoft: null,\n    },\n    white: null, black: null, transparent: null,\n  },\n  text: {\n    family: { ui: null, number: null },\n    size: {\n      micro: null, waypointCaption: null, probability: null,\n      waypoint: null, forecast: null, body: null, action: null,\n      station: null, routeCard: null, route: null, errorTitle: null,\n      entryTitle: null, routeCardNumber: null,\n    },\n    weight: { medium: null, semibold: null, bold: null, extraBold: null, black: null },\n    lineHeight: { tight: null, title: null, waypoint: null, station: null, body: null },\n    letterSpacing: { route: null, title: null, entry: null, station: null, label: null },\n  },\n}, (_value, path) => `--${path.join('-')}`);",
                      "lineHeight": 1.42,
                      "fontFamily": "Roboto Mono",
                      "fontSize": 9.2,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "S9mnE8",
                  "x": 760,
                  "y": 252,
                  "name": "Theme values 코드 블록",
                  "clip": true,
                  "width": 680,
                  "height": 950,
                  "fill": "#171717",
                  "cornerRadius": 10,
                  "layout": "vertical",
                  "padding": 22,
                  "children": [
                    {
                      "type": "text",
                      "id": "LtF2J",
                      "name": "Theme values 코드 블록 코드",
                      "fill": "#F7F7F5",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "import { createGlobalTheme } from '@vanilla-extract/css';\nimport { tokens } from './tokens.css';\n\ncreateGlobalTheme(':root', tokens, {\n  color: {\n    surface: { default: '#FFFFFF', subtle: '#F7F7F5', error: '#F8FAFC' },\n    text: {\n      primary: '#171B22', station: '#151515', secondary: '#454545',\n      muted: '#6B7280', entryMuted: '#66635E', currentMuted: '#6B6A6A',\n    },\n    action: { selected: '#111111', accent: '#E53D4D' },\n    border: {\n      default: '#D8D5CF', action: '#DFE3E8',\n      subtle: '#E3E2DE', selection: '#171717',\n    },\n    route: { line: '#B8B4AC', divider: '#E2DFD8' },\n    waypoint: {\n      background: '#F7F8FA', text: '#5B6472',\n      divider: '#E3E6EA', muted: '#AAB2BC',\n    },\n    probability: {\n      high: { fill: '#DCE8DE', stroke: '#6F9276', text: '#31573A' },\n      low: { fill: '#EEE6C9', stroke: '#C3A34C', text: '#6D5B1D' },\n      veryLow: { fill: '#E9D7D5', stroke: '#B9655E', text: '#7D352F' },\n    },\n    live: { bus: '#C93B32', currentLabel: '#6B6A6A' },\n    mascot: {\n      ink: '#242426', coral: '#F58678', coralDark: '#EE7066',\n      gray: '#E5ECED', blue: '#8BD0E7', pink: '#F9D0CB', pinkSoft: '#FDE0DC',\n    },\n    white: '#FFFFFF', black: '#000000', transparent: '#FFFFFF00',\n  },\n  text: {\n    family: { ui: '\"Noto Sans KR\", sans-serif', number: 'Inter, sans-serif' },\n    size: {\n      micro: '7px', waypointCaption: '10.5px', probability: '11.5px',\n      waypoint: '13px', forecast: '13.5px', body: '14px', action: '15px',\n      station: '15.5px', routeCard: '17px', route: '21px',\n      errorTitle: '25px', entryTitle: '28px', routeCardNumber: '30px',\n    },\n    weight: { medium: '500', semibold: '600', bold: '700', extraBold: '800', black: '900' },\n    lineHeight: { tight: '1.1', title: '1.25', waypoint: '1.3', station: '1.35', body: '1.55' },\n    letterSpacing: { route: '-0.6px', title: '-0.5px', entry: '-0.2px', station: '-0.25px', label: '-0.15px' },\n  },\n});",
                      "lineHeight": 1.42,
                      "fontFamily": "Roboto Mono",
                      "fontSize": 9.2,
                      "fontWeight": "normal"
                    }
