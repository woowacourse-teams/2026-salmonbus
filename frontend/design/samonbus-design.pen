                  "width": 672,
                  "content": "01  export const tokens = createGlobalThemeContract({\n02    color: {\n03      probability: {\n04        high:    { fill: null, stroke: null, text: null },\n05        low:     { fill: null, stroke: null, text: null },\n06        veryLow: { fill: null, stroke: null, text: null },\n07      },\n08      text: { primary: null, station: null, secondary: null },\n09      surface: { default: null, subtle: null, error: null },\n10    },\n11    text: {\n12      family: { ui: null, number: null },\n13      size: { probability: null, station: null, errorTitle: null },\n14      weight: { medium: null, semibold: null, black: null },\n15      lineHeight: { title: null, station: null, body: null },\n16    },\n17  }, (_value, path) => `--${path.join('-')}`);\n18\n19  createGlobalTheme(':root', tokens, {\n20    color: {\n21      probability: {\n22        high: {\n23          fill: '#DCE8DE',\n24          stroke: '#6F9276',\n25          text: '#31573A',\n26        },\n27        low: {\n28          fill: '#EEE6C9',\n29          stroke: '#C3A34C',\n30          text: '#6D5B1D',\n31        },\n32        veryLow: {\n33          fill: '#E9D7D5',\n34          stroke: '#B9655E',\n35          text: '#7D352F',\n36        },\n37      },\n38    },\n39    text: {\n40      family: { ui: '\"Noto Sans KR\"', number: 'Inter' },\n41      size: { probability: '11.5px', station: '15.5px', errorTitle: '25px' },\n42      weight: { medium: '500', semibold: '600', black: '900' },\n43      lineHeight: { title: '1.25', station: '1.35', body: '1.55' },\n44    },\n45  });",
                  "lineHeight": 1.42,
