              "textGrowth": "fixed-width",
              "width": 320,
              "content": "예보는 사실처럼 말하지 않는다",
              "lineHeight": 1.35,
              "fontFamily": "$roe-font",
              "fontSize": 18,
              "fontWeight": "750"
            },
            {
              "type": "text",
