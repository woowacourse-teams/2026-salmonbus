                  "id": "aqBZv",
                  "x": 40,
                  "y": 1298,
                  "name": "Typography recipe 코드 블록",
                  "clip": true,
                  "width": 680,
                  "height": 800,
                  "fill": "#171717",
                  "cornerRadius": 10,
                  "layout": "vertical",
