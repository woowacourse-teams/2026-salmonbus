                                      "width": "fill_container",
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "EHRwZ",
                                          "name": "가운데는 대기 인원을 회색 막대 길이로 보여준다. 사람 그림 대신 길이와 숫자만 남긴다.",
                                          "fill": "#626c7aff",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "가운데는 대기 인원을 회색 막대\n길이로 보여준다. 사람 그림 대신\n길이와 숫자만 남긴다.",
                                          "lineHeight": 1.5294117647058822,
                                          "textAlignVertical": "middle",
                                          "fontFamily": "Noto Sans KR",
                                          "fontSize": 8.5,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "S3LRY",
                                      "name": "Container",
                                      "width": "fill_container",
                                      "layout": "vertical",
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "b8Wwu0",
