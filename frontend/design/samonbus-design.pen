          "y": 1762,
          "name": "Recipe Playground 코드",
          "clip": true,
          "width": 800,
          "height": 520,
          "fill": "$roe-v2-text",
          "cornerRadius": 10,
          "layout": "none",
          "children": [
            {
              "type": "text",
              "id": "WW9UV",
              "x": 20,
              "y": 18,
              "name": "Recipe Playground 파일명",
              "fill": "#FFFFFF99",
              "content": "probability.css.ts",
              "fontFamily": "Roboto Mono",
              "fontSize": 9.5,
              "fontWeight": "700"
            },
            {
              "type": "text",
              "id": "aFBtG",
              "x": 20,
              "y": 54,
              "name": "Recipe Playground 코드 내용",
              "fill": "#F7F7F5",
              "textGrowth": "fixed-width",
              "width": 758,
              "content": "import { createVar, style, styleVariants } from\n  '@vanilla-extract/css';\nimport { tokens } from './tokens.css';\n\nconst fill = createVar();\nconst stroke = createVar();\nconst foreground = createVar();\n\nexport const probability = styleVariants({\n  high: { vars: {\n    [fill]: tokens.color.probability.high.fill,\n    [stroke]: tokens.color.probability.high.stroke,\n    [foreground]: tokens.color.probability.high.text,\n  } },\n  low: { vars: {\n    [fill]: tokens.color.probability.low.fill,\n    [stroke]: tokens.color.probability.low.stroke,\n    [foreground]: tokens.color.probability.low.text,\n  } },\n});\n\nexport const label = style({\n  background: fill,\n  color: foreground,\n});",
              "lineHeight": 1.46,
              "fontFamily": "Roboto Mono",
              "fontSize": 10.2,
              "fontWeight": "normal"
            }
          ]
        },
