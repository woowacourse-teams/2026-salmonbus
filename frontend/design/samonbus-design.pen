                                        {
                                          "type": "text",
                                          "id": "wr1O3",
                                          "name": "왼쪽 레일과 닻이 노선의 진행 방 향을 만든다. 현재 정류장만 닻을 크게 하고 이름을 굵게 한다.",
                                          "fill": "#626c7aff",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "왼쪽 레일과 닻이 노선의 진행 방\n향을 만든다. 현재 정류장만 닻을\n크게 하고 이름을 굵게 한다.",
                                          "lineHeight": 1.5294117647058822,
                                          "textAlignVertical": "middle",
                                          "fontFamily": "Noto Sans KR",
                                          "fontSize": 8.5,
