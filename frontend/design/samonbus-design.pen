                  "children": [
                    {
                      "type": "text",
                      "id": "fUFNN",
                      "name": "Typography recipe 코드 블록 코드",
                      "fill": "#F7F7F5",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "import { styleVariants } from '@vanilla-extract/css';\nimport { tokens } from './tokens.css';\n\nconst ui = tokens.text.family.ui;\nconst number = tokens.text.family.number;\n\nexport const text = styleVariants({\n  entryTitle: {\n    fontFamily: ui, fontSize: tokens.text.size.entryTitle,\n    fontWeight: tokens.text.weight.extraBold,\n    lineHeight: tokens.text.lineHeight.title,\n    letterSpacing: tokens.text.letterSpacing.entry,\n  },\n  errorTitle: {\n    fontFamily: ui, fontSize: tokens.text.size.errorTitle,\n    fontWeight: tokens.text.weight.black,\n    lineHeight: tokens.text.lineHeight.title,\n    letterSpacing: tokens.text.letterSpacing.title,\n  },\n  routeNumber: {\n    fontFamily: number, fontSize: tokens.text.size.route,\n    fontWeight: tokens.text.weight.semibold,\n    letterSpacing: tokens.text.letterSpacing.route,\n  },\n  stationName: {\n    fontFamily: ui, fontSize: tokens.text.size.station,\n    fontWeight: tokens.text.weight.semibold,\n    lineHeight: tokens.text.lineHeight.station,\n    letterSpacing: tokens.text.letterSpacing.station,\n  },\n  probabilityLabel: {\n    fontFamily: ui, fontSize: tokens.text.size.probability,\n    fontWeight: tokens.text.weight.semibold,\n    letterSpacing: tokens.text.letterSpacing.label,\n  },\n  arrival: {\n    fontFamily: ui, fontSize: tokens.text.size.forecast,\n    fontWeight: tokens.text.weight.semibold,\n  },\n  errorDescription: {\n    fontFamily: ui, fontSize: tokens.text.size.body,\n    fontWeight: tokens.text.weight.medium,\n    lineHeight: tokens.text.lineHeight.body,\n  },\n  seatLabel: {\n    fontFamily: ui, fontSize: tokens.text.size.micro,\n    fontWeight: tokens.text.weight.semibold,\n    lineHeight: tokens.text.lineHeight.tight,\n  },\n});",
                      "lineHeight": 1.43,
                      "fontFamily": "Roboto Mono",
                      "fontSize": 9.4,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "VLe94",
                  "x": 760,
                  "y": 1298,
                  "name": "Semantic usage 코드 블록",
                  "clip": true,
                  "width": 680,
                  "height": 800,
                  "fill": "#171717",
                  "cornerRadius": 10,
                  "layout": "vertical",
                  "padding": 22,
                  "children": [
                    {
                      "type": "text",
                      "id": "EvZ7S",
                      "name": "Semantic usage 코드 블록 코드",
                      "fill": "#F7F7F5",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "import { createVar, style, styleVariants } from\n  '@vanilla-extract/css';\nimport { tokens } from './tokens.css';\nimport { text } from './typography.css';\n\nconst fill = createVar();\nconst stroke = createVar();\nconst foreground = createVar();\n\nexport const probability = styleVariants({\n  high: { vars: {\n    [fill]: tokens.color.probability.high.fill,\n    [stroke]: tokens.color.probability.high.stroke,\n    [foreground]: tokens.color.probability.high.text,\n  } },\n  low: { vars: {\n    [fill]: tokens.color.probability.low.fill,\n    [stroke]: tokens.color.probability.low.stroke,\n    [foreground]: tokens.color.probability.low.text,\n  } },\n  veryLow: { vars: {\n    [fill]: tokens.color.probability.veryLow.fill,\n    [stroke]: tokens.color.probability.veryLow.stroke,\n    [foreground]: tokens.color.probability.veryLow.text,\n  } },\n});\n\nexport const label = style([text.probabilityLabel, {\n  background: fill, color: foreground,\n}]);\n\nexport const ring = style({\n  background: fill, border: `2px solid ${stroke}`,\n});\n\n// StationRow.tsx\n<span className={`${label} ${probability[state]}`}>\n  {copy[state]}\n</span>\n\n// raw hex와 raw font-size는 컴포넌트에서 금지\n// unknown은 색 추론 대신 '판정 보류' 문구 사용",
                      "lineHeight": 1.43,
                      "fontFamily": "Roboto Mono",
                      "fontSize": 9.4,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "rectangle",
                  "id": "CQ1PM",
