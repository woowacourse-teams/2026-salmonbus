{
  "request": {
    "method": "GET",
    "urlPath": "/buslocationservice/v2/getBusLocationListv2",
    "queryParameters": {
      "serviceKey": {
        "equalTo": "local-only-placeholder"
      },
      "format": {
        "equalTo": "json"
      },
      "routeId": {
        "matches": "(234000050|204000057|204000070|234000886|233000392|227000038|228000184|234000051)"
      }
    }
  },
  "response": {
    "status": 200,
    "transformers": [
      "gbis-replay"
    ],
    "transformerParameters": {
      "operation": "location"
    }
  }
}
