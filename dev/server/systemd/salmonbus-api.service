[Unit]
Description=salmonbus dev API
After=network-online.target salmonbus-dev-infra.service
Wants=network-online.target
Requires=salmonbus-dev-infra.service
RequiresMountsFor=/srv/salmonbus-dev

[Service]
Type=simple
User=salmonbus
Group=salmonbus
EnvironmentFile=/etc/salmonbus-dev/api.env
EnvironmentFile=/opt/salmonbus-dev/api/current/release.env
UnsetEnvironment=JAVA_TOOL_OPTIONS JDK_JAVA_OPTIONS _JAVA_OPTIONS CLASSPATH
ExecStartPre=+/usr/bin/java -Xms16m -Xmx64m -jar /opt/salmonbus-dev/tools/shared-dev-tools.jar preflight api
ExecStart=/usr/bin/java -Xms128m -Xmx256m -jar /opt/salmonbus-dev/api/current/jars/api-app.jar --spring.config.additional-location=file:/etc/salmonbus-dev/api.yml --spring.datasource.url=jdbc:postgresql://127.0.0.1:15432/salmonbus_dev --spring.datasource.username=salmonbus_dev
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
