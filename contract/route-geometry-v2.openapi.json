{
  "openapi": "3.1.0",
  "info": {
    "title": "Salmonbus route geometry",
    "version": "2.0.0",
    "description": "노선 선택 시 전체 도로 형상과 정류장 마커를 한 번 조회하는 계약. dev는 41노선의 GBIS 정적 저장 자료를 재생하며 초기 수집 상태는 응답 본문으로 구분한다. 예시는 합성 자료다."
  },
  "paths": {
    "/api/v2/routes/{routeId}/geometry": {
      "get": {
        "operationId": "getRouteGeometry",
        "summary": "노선 도로 형상과 정류장 좌표",
        "parameters": [
          {
            "name": "routeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{9}$"
            },
            "description": "노선 목록에서 선택한 9자리 GBIS 노선 ID."
          },
          {
            "name": "referenceVersionId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "description": "생략하면 현재 판본. 지정한 판본이 현재와 다르면 409이므로 판본 없이 geometry를 다시 조회한다. 과거 판본 조회가 아니다. 양의 64비트 정수 문자열."
          },
          {
            "name": "If-None-Match",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "이전 READY/PARTIAL 응답의 ETag. 일치하면 본문 없는 304. UNAVAILABLE 또는 오류에는 재사용하지 않는다."
          }
        ],
        "responses": {
          "200": {
            "description": "READY: 형상과 모든 정류장 좌표. PARTIAL: 형상은 있고 일부 point=null. UNAVAILABLE/NOT_COLLECTED: 현재 판본 형상 미수집. READY여도 paths=null 가능. 예시는 합성 자료.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "W/\"g-{geometryRevision}\". If-None-Match로 재검증한다. UNAVAILABLE에는 제공하지 않는다."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "READY/PARTIAL은 max-age=300, must-revalidate, public. UNAVAILABLE은 no-store."
              },
              "Content-Encoding": {
                "schema": {
                  "type": "string"
                },
                "description": "Accept-Encoding:gzip을 수락하고 본문이 2KB 이상이면 gzip 압축 가능."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteGeometry"
                },
                "examples": {
                  "ready": {
                    "value": {
                      "routeId": "204000057",
                      "referenceVersionId": "7",
                      "geometryRevision": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc",
                      "name": "3330",
                      "startPoint": "합성 기점 A",
                      "endPoint": "합성 회차 B",
                      "status": "READY",
                      "reason": null,
                      "coordinateSystem": "WGS84_ASSUMED",
                      "turningPoint": {
                        "stopSequence": 2
                      },
                      "busStops": [
                        {
                          "stationId": "206000637",
                          "stopSequence": 1,
                          "name": "합성 A",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        },
                        {
                          "stationId": "206000638",
                          "stopSequence": 2,
                          "name": "합성 B",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127.2,
                            "y": 37.1
                          }
                        },
                        {
                          "stationId": "206000637",
                          "stopSequence": 3,
                          "name": "합성 A",
                          "direction": "DOWN",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        }
                      ],
                      "points": [
                        {
                          "x": 127,
                          "y": 37
                        },
                        {
                          "x": 127.1,
                          "y": 37.05
                        },
                        {
                          "x": 127.2,
                          "y": 37.1
                        },
                        {
                          "x": 127,
                          "y": 37
                        }
                      ],
                      "paths": {
                        "UP": {
                          "points": [
                            {
                              "x": 127,
                              "y": 37
                            },
                            {
                              "x": 127.1,
                              "y": 37.05
                            },
                            {
                              "x": 127.2,
                              "y": 37.1
                            }
                          ]
                        },
                        "DOWN": {
                          "points": [
                            {
                              "x": 127.2,
                              "y": 37.1
                            },
                            {
                              "x": 127,
                              "y": 37
                            }
                          ]
                        }
                      },
                      "boundary": {
                        "left": 127,
                        "top": 37.1,
                        "right": 127.2,
                        "bottom": 37
                      }
                    },
                    "summary": "READY: 전체 형상·정류장·양방향 경로",
                    "description": "합성 예시. 도로 형상과 정류장 좌표가 모두 있고 회차 분리 근거도 있는 경우입니다."
                  },
                  "partial": {
                    "value": {
                      "routeId": "204000057",
                      "referenceVersionId": "7",
                      "geometryRevision": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd",
                      "name": "3330",
                      "startPoint": "합성 기점 A",
                      "endPoint": "합성 회차 B",
                      "status": "PARTIAL",
                      "reason": "MISSING_STOP_COORDINATES",
                      "coordinateSystem": "WGS84_ASSUMED",
                      "turningPoint": {
                        "stopSequence": 2
                      },
                      "busStops": [
                        {
                          "stationId": "206000637",
                          "stopSequence": 1,
                          "name": "합성 A",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        },
                        {
                          "stationId": "206000638",
                          "stopSequence": 2,
                          "name": "합성 B",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": null
                        },
                        {
                          "stationId": "206000637",
                          "stopSequence": 3,
                          "name": "합성 A",
                          "direction": "DOWN",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        }
                      ],
                      "points": [
                        {
                          "x": 127,
                          "y": 37
                        },
                        {
                          "x": 127.1,
                          "y": 37.05
                        },
                        {
                          "x": 127.2,
                          "y": 37.1
                        },
                        {
                          "x": 127,
                          "y": 37
                        }
                      ],
                      "paths": null,
                      "boundary": {
                        "left": 127,
                        "top": 37.1,
                        "right": 127.2,
                        "bottom": 37
                      }
                    },
                    "summary": "PARTIAL: 형상 유지·정류장 좌표 일부 누락",
                    "description": "합성 예시. point=null인 정류장의 마커를 생략하고 전체 points를 표시합니다. 회차 좌표 누락으로 paths=null입니다."
                  },
                  "notCollected": {
                    "value": {
                      "routeId": "204000057",
                      "referenceVersionId": "7",
                      "geometryRevision": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee",
                      "name": "3330",
                      "startPoint": "합성 기점 A",
                      "endPoint": "합성 회차 B",
                      "status": "UNAVAILABLE",
                      "reason": "NOT_COLLECTED",
                      "coordinateSystem": "WGS84_ASSUMED",
                      "turningPoint": {
                        "stopSequence": 2
                      },
                      "busStops": [
                        {
                          "stationId": "206000637",
                          "stopSequence": 1,
                          "name": "합성 A",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        },
                        {
                          "stationId": "206000638",
                          "stopSequence": 2,
                          "name": "합성 B",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127.2,
                            "y": 37.1
                          }
                        },
                        {
                          "stationId": "206000637",
                          "stopSequence": 3,
                          "name": "합성 A",
                          "direction": "DOWN",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        }
                      ],
                      "points": [],
                      "paths": null,
                      "boundary": {
                        "left": 127,
                        "top": 37.1,
                        "right": 127.2,
                        "bottom": 37
                      }
                    },
                    "summary": "UNAVAILABLE: 현재 판본 형상 미수집",
                    "description": "합성 예시. points는 빈 배열, paths는 null입니다. 제공된 정류장 좌표로 마커만 표시할 수 있습니다."
                  },
                  "withoutDirectionSplit": {
                    "summary": "READY: 전체 형상 제공·방향 분리 근거 없음",
                    "value": {
                      "routeId": "204000057",
                      "referenceVersionId": "7",
                      "geometryRevision": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
                      "name": "3330",
                      "startPoint": "합성 기점 A",
                      "endPoint": "합성 회차 B",
                      "status": "READY",
                      "reason": null,
                      "coordinateSystem": "WGS84_ASSUMED",
                      "turningPoint": null,
                      "busStops": [
                        {
                          "stationId": "206000637",
                          "stopSequence": 1,
                          "name": "합성 A",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        },
                        {
                          "stationId": "206000638",
                          "stopSequence": 2,
                          "name": "합성 B",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127.2,
                            "y": 37.1
                          }
                        },
                        {
                          "stationId": "206000637",
                          "stopSequence": 3,
                          "name": "합성 A",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "point": {
                            "x": 127,
                            "y": 37
                          }
                        }
                      ],
                      "points": [
                        {
                          "x": 127,
                          "y": 37
                        },
                        {
                          "x": 127.1,
                          "y": 37.05
                        },
                        {
                          "x": 127.2,
                          "y": 37.1
                        },
                        {
                          "x": 127,
                          "y": 37
                        }
                      ],
                      "paths": null,
                      "boundary": {
                        "left": 127,
                        "top": 37.1,
                        "right": 127.2,
                        "bottom": 37
                      }
                    },
                    "description": "합성 예시. READY가 paths의 존재를 보장하지 않습니다. paths=null이면 전체 points를 표시합니다."
                  }
                }
              }
            }
          },
          "304": {
            "description": "기존 ETag와 동일한 표시 자료. 본문 없음.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "W/\"g-{geometryRevision}\". If-None-Match로 재검증한다. UNAVAILABLE에는 제공하지 않는다."
              },
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "READY/PARTIAL은 max-age=300, must-revalidate, public. UNAVAILABLE은 no-store."
              },
              "Content-Encoding": {
                "schema": {
                  "type": "string"
                },
                "description": "Accept-Encoding:gzip을 수락하고 본문이 2KB 이상이면 gzip 압축 가능."
              }
            }
          },
          "400": {
            "description": "잘못된 routeId 또는 판본 형식: INVALID_ROUTE_ID/INVALID_REQUEST",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "현재 카탈로그에 없는 노선: ROUTE_NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "지정한 판본이 현재 판본과 다름. referenceVersionId 없이 geometry를 다시 조회하고 새 방문 순번으로 선택을 갱신",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "저장소 또는 저장된 형상 조회 불가. 형상 미수집을 뜻하는 200/UNAVAILABLE과 구분. no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 HTTP 메서드",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "METHOD_NOT_ALLOWED",
                  "message": "이 경로에서 지원하지 않는 요청 방식입니다.",
                  "requestId": "example-request"
                }
              }
            }
          },
          "500": {
            "description": "요청 처리 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "요청을 처리하지 못했습니다.",
                  "requestId": "example-request"
                }
              }
            }
          }
        },
        "description": "노선 목록에서 선택한 routeId로 한 번 조회합니다. `points`는 원본 운행 순서의 전체 도로 형상이고,\n`busStops[].point`는 정류장 마커 좌표입니다. 정류장 좌표를 이어 도로 형상을 만들지 않습니다.\n같은 stationId의 반복 방문은 `stopSequence`로 구분합니다. `turningPoint.stopSequence`도 방문 순번이며 형상 배열 인덱스가 아닙니다.\n\n`paths`가 있으면 `UP.points`와 `DOWN.points`를 함께 사용합니다. 두 경로는 회차 경계점을 공유하며,\n하행을 상행의 역순으로 만들지 않습니다. 방문 순서와 회차를 형상에 대응할 근거가 부족하거나 모호하면\nREADY여도 `paths=null`일 수 있으므로 전체 `points`를 표시합니다. 방향 선택·색상·겹침 순서는 프론트에서 처리하고,\n방향 전환이나 지도 확대·이동마다 재조회하지 않습니다.\n\nREADY는 도로 형상과 모든 정류장 좌표 제공, PARTIAL은 도로 형상을 유지하되 일부 정류장의 `point=null`인 상태입니다.\nUNAVAILABLE/NOT_COLLECTED는 현재 판본의 형상 미수집으로 `points=[]`, `paths=null`이며, 정류장 좌표가 있으면 마커만 표시할 수 있습니다.\ndev 공급 자료는 현재 41노선의 정류장 방문 3,215건과 형상점 35,542개를 포함한 GBIS 정적 재생 자료입니다.\n8노선은 기존 정적 API 저장본, 33노선은 공식 공개 지도 형상입니다. 방문 건수는 고유 물리 정류장 수가 아닙니다.\n초기 수집 완료 전이나 새 카탈로그 판본으로 바뀐 직후에는 미수집 상태일 수 있으며, dev 자료가 실시간 최신성을 보장하지는 않습니다.\n\n`referenceVersionId`를 생략하면 현재 판본을 반환합니다. 지정한 판본이 현재와 다르면 409이며 판본 없이 다시 조회합니다.\n새 판본에는 이전 판본의 정류장 좌표·형상을 붙이지 않습니다. READY/PARTIAL은 최대 5분 캐시와 ETag 재검증을 지원하며,\n같은 ETag에는 본문 없는 304를 반환합니다. UNAVAILABLE과 오류는 no-store이고, 저장소·저장 형상을 읽을 수 없으면 503입니다.\n조회는 외부 수집을 유발하지 않으며 모델·차량 관측의 준비 상태와 독립적입니다.\n"
      }
    }
  },
  "components": {
    "schemas": {
      "Point": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "not": {
              "const": 0
            }
          },
          "y": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "not": {
              "const": 0
            }
          }
        },
        "additionalProperties": false,
        "description": "GBIS X/Y를 x=경도·y=위도로 표시하는 가정. 공급자 형상 명세의 좌표계 보증은 미확인."
      },
      "BusStop": {
        "type": "object",
        "required": [
          "stationId",
          "stopSequence",
          "name",
          "direction",
          "boardingAllowed",
          "point"
        ],
        "properties": {
          "stationId": {
            "type": "string",
            "pattern": "^[0-9]{9}$"
          },
          "stopSequence": {
            "type": "integer",
            "minimum": 1,
            "description": "노선 판본 안의 1부터 시작하는 방문 순번. stationId가 같아도 합치지 않는다."
          },
          "name": {
            "type": "string"
          },
          "direction": {
            "type": "string",
            "enum": [
              "UP",
              "DOWN"
            ],
            "description": "회차 방문까지 UP이며 다음 방문부터 DOWN. 이 값만으로 형상 points를 분리하지 않는다."
          },
          "boardingAllowed": {
            "type": "boolean"
          },
          "point": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Point"
              },
              {
                "type": "null"
              }
            ],
            "description": "정류장 마커 좌표(x=경도,y=위도). 미제공·유효하지 않은 좌표이면 null로 유지하고 마커를 생략한다. 도로 형상 points와 별개다."
          }
        },
        "additionalProperties": false
      },
      "Boundary": {
        "type": "object",
        "required": [
          "left",
          "top",
          "right",
          "bottom"
        ],
        "properties": {
          "left": {
            "type": "number"
          },
          "top": {
            "type": "number"
          },
          "right": {
            "type": "number"
          },
          "bottom": {
            "type": "number"
          }
        },
        "additionalProperties": false,
        "description": "경로점과 제공 가능한 정류장 좌표를 모두 포함하는 영역. left=min x, right=max x, top=max y, bottom=min y."
      },
      "TurningPoint": {
        "type": "object",
        "required": [
          "stopSequence"
        ],
        "properties": {
          "stopSequence": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "description": "회차 정류장의 방문 순번. 형상 배열 인덱스가 아니며 값이 있어도 방향 분리 근거가 충분하다는 뜻은 아니다."
      },
      "RouteGeometry": {
        "type": "object",
        "required": [
          "routeId",
          "referenceVersionId",
          "geometryRevision",
          "name",
          "startPoint",
          "endPoint",
          "status",
          "reason",
          "coordinateSystem",
          "turningPoint",
          "busStops",
          "points",
          "paths",
