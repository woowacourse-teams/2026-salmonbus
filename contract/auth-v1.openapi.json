                    "description": "csrfRejected",
                    "value": {
                      "code": "CSRF_REJECTED",
                      "message": "요청을 확인하지 못했습니다. 페이지를 새로고침한 뒤 다시 시도해 주세요.",
                      "requestId": "example-request"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "액세스 토큰이 없거나 만료·위조됨, 또는 탈퇴한 회원",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
