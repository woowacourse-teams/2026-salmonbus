              "FAVORITE_LIMIT_EXCEEDED",
              "INVALID_FAVORITE_GROUP_NAME",
              "FAVORITE_GROUP_NAME_CONFLICT",
              "FAVORITE_GROUP_NOT_FOUND",
              "LAST_FAVORITE_GROUP",
              "INVALID_FAVORITE_ORDER",
              "FAVORITE_TARGET_AMBIGUOUS",
              "FAVORITE_TARGET_UNAVAILABLE",
              "INVALID_REQUEST",
              "ENDPOINT_NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "INTERNAL_ERROR",
              "UNAUTHENTICATED",
              "CSRF_REJECTED",
              "NICKNAME_LENGTH",
              "NICKNAME_CHARACTERS",
              "NICKNAME_RESERVED",
              "NICKNAME_TAKEN",
              "REAUTH_REQUIRED"
            ]
          },
          "message": {
