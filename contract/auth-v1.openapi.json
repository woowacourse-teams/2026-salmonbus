                      "message": "로그인이 필요합니다.",
                      "requestId": "example-request"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/me/withdrawal/apple/native": {
      "post": {
        "summary": "회원 탈퇴(애플, 앱)",
        "description": "앱의 애플 회원이 Sign in with Apple로 다시 인증해 받은 `authorizationCode`로 탈퇴합니다.\n서버가 코드를 앱 `client_id`로 교환해 다시 인증한 계정이 이 회원인지 확인하고, 애플 토큰을 취소한 뒤 회원을 지웁니다.\n탈퇴하면 인증 쿠키 두 개를 지우고 204로 답합니다.\n- 코드가 틀렸거나 만료됐거나(5분, 1회), 다른 애플 계정이거나, 애플 토큰을 취소하지 못하면 409 `REAUTH_REQUIRED`입니다.\n  회원과 인증 쿠키는 그대로이므로 다시 인증해 새 코드로 시도합니다\n- 애플이 응답하지 않으면 503 `SERVICE_UNAVAILABLE`이고 회원은 그대로입니다\n- 카카오 회원이거나 본문에 코드가 없으면 400 `INVALID_REQUEST`입니다. 카카오 회원은 `DELETE /api/me`로 탈퇴합니다\n- 애플 앱 로그인이 켜지지 않았으면 404 `ENDPOINT_NOT_FOUND`입니다\n\n액세스 토큰은 `Authorization: Bearer` 헤더를 먼저 보고, 헤더가 없거나 토큰 값이 비어 있으면 `__Host-sb_at` 쿠키를 봅니다. 헤더에 토큰 값이 있으면 그 토큰이 검증에 실패해도 쿠키를 보지 않습니다. 인증 쿠키(`__Host-sb_at`·`__Host-sb_rt`)가 실린 요청은 `Authorization: Bearer` 헤더가 없으면 `X-XSRF-TOKEN` 헤더에 `__Host-XSRF-TOKEN` 쿠키 값을 실어야 합니다.",
        "operationId": "withdrawAppleFromApp",
        "parameters": [
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "description": "__Host-XSRF-TOKEN 쿠키 값. 인증 쿠키가 실려 있고 Authorization: Bearer 헤더가 없으면 필수",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppleAppWithdrawalRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "탈퇴함. 본문 없음",
            "headers": {
              "Cache-Control": {
                "description": "no-store",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              },
              "Set-Cookie": {
                "description": "__Host-sb_at과 __Host-sb_rt를 Max-Age=0으로 지움",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "카카오 회원, 코드 없음, CSRF 토큰 확인 실패 또는 사이트가 아닌 출처",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "invalidRequest": {
                    "description": "invalidRequest",
                    "value": {
                      "code": "INVALID_REQUEST",
