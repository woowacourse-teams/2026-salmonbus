            "type": "string",
            "description": "로그인 제공자",
            "enum": [
              "KAKAO",
              "APPLE"
            ]
          }
        },
        "required": [
          "id",
          "nickname",
          "provider"
        ]
      },
      "MyProfileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "회원 공개 ID"
          },
          "nickname": {
            "type": "string",
            "description": "닉네임. 가입할 때 무작위로 정해지고 PATCH /api/me로 바꾼다"
          },
          "provider": {
            "type": "string",
