                    "value": {
                      "code": "REAUTH_REQUIRED",
                      "message": "애플 계정으로 한 번 더 인증해야 탈퇴할 수 있습니다.",
                      "requestId": "example-request"
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "애플이 응답하지 않음. 회원은 그대로",
