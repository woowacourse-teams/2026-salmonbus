  "components": {
    "schemas": {
      "AuthSessionResponse": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean",
            "description": "유효한 액세스 토큰이 있고 회원이 있으면 true"
          },
          "refreshable": {
            "type": "boolean",
            "description": "authenticated=false이고 리프레시 토큰 쿠키가 있으면 true. POST /api/auth/refresh로 이어 갈 수 있다는 뜻이며 토큰이 유효한지는 확인하지 않는다. authenticated=true면 항상 false"
          },
          "member": {
