{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://salmonbus.dev/contracts/route-display-manual-v1.schema.json",
  "title": "Reviewed route display import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "status",
    "algorithm",
    "routeId",
    "inputDigest",
    "displayPaths",
    "connections",
    "visits",
    "review"
  ],
  "properties": {
    "format": {
      "const": "route-display-manual-v1"
    },
    "status": {
      "const": "REVIEWED"
    },
    "algorithm": {
      "type": "string",
      "pattern": "\\S"
    },
    "routeId": {
      "type": "string",
      "pattern": "^[0-9]{9}$"
    },
    "inputDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "displayPaths": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "UP",
        "DOWN"
      ],
      "properties": {
        "UP": {
          "$ref": "#/$defs/path"
        },
        "DOWN": {
          "$ref": "#/$defs/path"
        }
      }
    },
    "connections": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/connection"
      }
    },
    "visits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/visit"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewedAt"
      ],
      "properties": {
        "reviewer": {
          "type": "string",
          "pattern": "\\S"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -180,
          "maximum": 180,
          "not": {
            "const": 0
          }
        },
        "y": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "not": {
            "const": 0
          }
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points"
      ],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/point"
          }
        }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "point",
        "segmentIndex",
        "segmentFraction"
      ],
      "properties": {
        "point": {
          "$ref": "#/$defs/point"
        },
        "segmentIndex": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "segmentFraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "visit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stationId",
        "sequence",
        "direction",
        "boardingAllowed",
        "sourcePoint",
        "displayPoint"
      ],
      "properties": {
        "stationId": {
          "type": "string",
          "pattern": "\\S"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "direction": {
          "enum": [
            "UP",
            "DOWN"
          ]
        },
        "boardingAllowed": {
          "type": "boolean"
        },
        "sourcePoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "displayPoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
