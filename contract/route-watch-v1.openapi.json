{
  "openapi": "3.1.0",
  "info": {
    "title": "Salmonbus route watch board",
    "version": "1.0.0",
    "description": "노선의 판정 보드(정류장별 도착 예보)와 같은 관측의 차량 위치를 한 번에 폴링으로 조회하는 계약. 200 응답 전체는 관측 하나에서 나온다. 예시는 합성 자료다."
  },
  "paths": {
    "/api/v1/routes/{routeId}/watch": {
      "get": {
        "summary": "노선별 판정 보드와 차량 위치",
        "description": "발행된 예보가 있으면 해당 관측을, 없으면 최신 정상 관측을 기준으로 보드를 구성하고, 같은 관측의 차량 위치를 함께 반환합니다. 화면이 주기적으로 다시 부르는 폴링용 조회입니다. 200 응답은 전체가 관측 하나에서 나온 것입니다. 신선도는 관측 후 5분, 관측 시각이 01~03시대면 10분입니다.",
        "operationId": "getRouteWatch",
        "parameters": [
          {
            "name": "routeId",
            "in": "path",
            "description": "9자리 GBIS 노선 ID",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": 123456789
          }
        ],
        "responses": {
          "200": {
            "description": "보드 상태별 정상 응답",
            "headers": {
              "Cache-Control": {
                "description": "public, max-age는 관측 시각대별 정책값(07~08시·17~22시 15초, 01~03시대 600초, 그 밖의 시간 20초)과 staleAt까지 남은 시간 중 작은 값. staleAt을 넘겨 캐시하지 않는다",
                "style": "simple",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WatchBoardResponse"
                },
                "examples": {
                  "FORECAST_READY": {
                    "description": "FORECAST_READY",
                    "value": {
                      "route": {
                        "id": "123456789",
                        "displayName": "예시 노선",
                        "startStopName": "기점",
                        "endStopName": "종점",
                        "status": "FORECAST_READY",
                        "turnSequence": 2,
                        "directions": [
                          {
                            "id": "UP",
                            "name": "회차점 방면",
                            "originStopName": "기점",
                            "terminalStopName": "회차점",
                            "firstDepartureTime": "05:00",
                            "lastDepartureTime": "23:00"
                          },
                          {
                            "id": "DOWN",
                            "name": "종점 방면",
                            "originStopName": "회차점",
                            "terminalStopName": "종점",
                            "firstDepartureTime": "05:00",
                            "lastDepartureTime": "23:00"
                          }
                        ],
                        "referenceVersionId": "7",
                        "headways": {
                          "weekday": {
                            "minMinutes": 10,
                            "maxMinutes": 20
                          },
                          "saturday": {
                            "minMinutes": 12,
                            "maxMinutes": 25
                          },
                          "sunday": {
                            "minMinutes": 15,
                            "maxMinutes": 30
                          },
                          "holiday": null
                        }
                      },
                      "observedAt": "2026-10-01T12:00:00+09:00",
                      "staleAt": "2026-10-01T12:05:00+09:00",
                      "model": {
                        "releaseId": "example-model",
                        "trainedThrough": "2026-09-30T00:00:00+09:00"
                      },
                      "vehiclesInService": 1,
                      "stops": [
                        {
                          "sequence": 1,
                          "stopId": "example-stop-1",
                          "name": "기점",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "approachingVehicles": []
                        },
                        {
                          "sequence": 2,
                          "stopId": "example-stop-2",
                          "name": "회차점",
                          "direction": "UP",
                          "boardingAllowed": false,
                          "approachingVehicles": []
                        },
                        {
                          "sequence": 3,
                          "stopId": "example-stop-3",
                          "name": "종점",
                          "direction": "DOWN",
                          "boardingAllowed": true,
                          "approachingVehicles": [
                            {
                              "vehicleId": "example-vehicle",
                              "remainingStops": 1,
                              "forecast": {
                                "status": "AVAILABLE",
                                "seatAvailableProbability": 0.7,
                                "expectedSeats": 4.0
                              }
                            }
                          ]
                        }
                      ],
                      "vehicles": [
                        {
                          "vehicleId": "example-vehicle",
                          "direction": "UP",
                          "currentStopSequence": 2,
                          "stopId": "example-stop-2",
                          "stopName": "회차점",
                          "phase": "ARRIVING",
                          "seat": {
                            "kind": "EXACT",
                            "remaining": 12
                          }
                        }
                      ]
                    }
                  },
                  "PREPARING": {
                    "description": "PREPARING",
                    "value": {
                      "route": {
                        "id": "123456789",
                        "displayName": "예시 노선",
                        "startStopName": "기점",
                        "endStopName": "종점",
                        "status": "PREPARING",
                        "turnSequence": 2,
                        "directions": [
                          {
                            "id": "UP",
                            "name": "회차점 방면",
                            "originStopName": "기점",
                            "terminalStopName": "회차점",
                            "firstDepartureTime": "05:00",
                            "lastDepartureTime": "23:00"
                          },
                          {
                            "id": "DOWN",
                            "name": "종점 방면",
                            "originStopName": "회차점",
                            "terminalStopName": "종점",
                            "firstDepartureTime": "05:00",
                            "lastDepartureTime": "23:00"
                          }
                        ],
                        "referenceVersionId": "7",
                        "headways": {
                          "weekday": null,
                          "saturday": null,
                          "sunday": null,
                          "holiday": null
                        }
                      },
                      "observedAt": "2026-10-01T12:00:00+09:00",
                      "staleAt": "2026-10-01T12:05:00+09:00",
                      "model": {
                        "releaseId": "example-model",
                        "trainedThrough": "2026-09-30T00:00:00+09:00"
                      },
                      "vehiclesInService": 1,
                      "stops": [
                        {
                          "sequence": 1,
                          "stopId": "example-stop-1",
                          "name": "기점",
                          "direction": "UP",
                          "boardingAllowed": true,
                          "approachingVehicles": []
                        },
                        {
                          "sequence": 2,
                          "stopId": "example-stop-2",
                          "name": "회차점",
                          "direction": "UP",
                          "boardingAllowed": false,
                          "approachingVehicles": []
                        },
                        {
                          "sequence": 3,
                          "stopId": "example-stop-3",
                          "name": "종점",
                          "direction": "DOWN",
                          "boardingAllowed": true,
                          "approachingVehicles": [
                            {
                              "vehicleId": "example-vehicle",
                              "remainingStops": 1,
                              "forecast": {
                                "status": "UNAVAILABLE"
                              }
                            }
                          ]
                        }
                      ],
                      "vehicles": [
                        {
                          "vehicleId": "example-vehicle",
                          "direction": "UP",
                          "currentStopSequence": 2,
                          "stopId": "example-stop-2",
                          "stopName": "회차점",
                          "phase": "ARRIVING",
                          "seat": {
                            "kind": "UNKNOWN",
                            "reason": "QUALITY_WITHHELD"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "노선 ID 형식이 올바르지 않음",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "INVALID_ROUTE_ID",
                  "message": "routeId는 9자리 숫자여야 합니다.",
                  "requestId": "example-request"
                }
              }
            }
          },
          "404": {
            "description": "등록되지 않은 노선",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "ROUTE_NOT_FOUND",
                  "message": "등록되지 않은 노선입니다.",
                  "requestId": "example-request"
                }
              }
            }
          },
          "503": {
            "description": "모델 범위 밖, 최근 정상 관측 없음 또는 DB 사용 불가. Cache-Control은 no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "MODEL_OUT_OF_SCOPE": {
                    "description": "MODEL_OUT_OF_SCOPE",
                    "value": {
                      "code": "MODEL_OUT_OF_SCOPE",
                      "message": "활성 모델 번들이 지원하지 않는 노선 판본입니다.",
                      "requestId": "example-request"
                    }
                  },
                  "NO_RECENT_OBSERVATION": {
                    "description": "NO_RECENT_OBSERVATION",
                    "value": {
                      "code": "NO_RECENT_OBSERVATION",
                      "message": "예보 기준으로 사용할 최근 차량 관측이 없습니다.",
                      "requestId": "example-request"
                    }
                  },
                  "SERVICE_UNAVAILABLE": {
                    "description": "SERVICE_UNAVAILABLE",
                    "value": {
                      "code": "SERVICE_UNAVAILABLE",
                      "message": "일시적인 서버 장애가 발생했습니다.",
                      "requestId": "example-request"
                    }
                  }
                }
              }
            }
          },
          "405": {
            "description": "지원하지 않는 요청 방식",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "METHOD_NOT_ALLOWED",
                  "message": "이 경로에서 지원하지 않는 요청 방식입니다.",
                  "requestId": "example-request"
                }
              }
            }
          },
          "500": {
            "description": "요청 처리 실패",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": "INTERNAL_ERROR",
                  "message": "요청을 처리하지 못했습니다.",
                  "requestId": "example-request"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApproachingVehicleResponse": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": [
              "string",
              "null"
            ],
            "description": "관측된 차량 ID. 제공되지 않으면 null"
          },
          "remainingStops": {
            "type": "integer",
            "format": "int32",
            "description": "대상 정류장 순번 − 버스가 있는 정류장 순번(GBIS stationSeq). 0이면 이 정류장에 도착 중이다",
            "maximum": 12,
            "minimum": 0
          },
          "forecast": {
            "$ref": "#/components/schemas/ForecastResponse",
            "description": "좌석 예보. 상태가 UNAVAILABLE이면 확률과 기대 좌석은 생략"
          }
        },
        "required": [
          "forecast",
          "remainingStops",
          "vehicleId"
        ]
      },
      "BoardRouteResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "GBIS 노선 ID. 9자리 숫자 문자열"
          },
          "displayName": {
            "type": "string",
            "description": "화면에 표시할 노선 이름"
          },
          "startStopName": {
            "type": "string",
            "description": "기점 이름"
          },
          "endStopName": {
            "type": "string",
            "description": "종점 이름"
          },
          "status": {
            "type": "string",
            "description": "현재 판본의 예보 준비 상태",
            "enum": [
              "FORECAST_READY",
              "PREPARING"
            ]
          },
          "turnSequence": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "회차 정류장 순번. 회차점이 없으면 null"
          },
          "directions": {
            "type": "array",
            "description": "상행/하행 방향 이름과 운행 시간",
            "items": {
              "$ref": "#/components/schemas/DirectionInfoResponse"
            }
          },
          "referenceVersionId": {
            "type": "string",
            "description": "이 응답이 기준으로 삼은 노선 판본 ID"
          },
          "headways": {
            "$ref": "#/components/schemas/RouteHeadwaysResponse",
            "description": "GBIS 노선 기본정보에 등록된 요일별 최소·최대 배차간격(분). 방향 구분이 없고 실제 도착 간격이나 평균이 아니다. GBIS가 맞지 않는 값을 보내면 그 요일은 마지막으로 받은 정상 값을 유지한다. 오늘이 공휴일인지는 판정하지 않는다. 이 필드가 없는 응답은 정보 없음으로 본다"
          }
        },
        "required": [
          "directions",
          "displayName",
          "endStopName",
          "id",
          "referenceVersionId",
          "startStopName",
          "status",
          "turnSequence"
        ]
      },
      "RouteHeadwaysResponse": {
        "type": "object",
        "properties": {
          "weekday": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeadwayRangeResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "평일 배차간격. 정보가 없으면 null"
          },
          "saturday": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeadwayRangeResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "토요일 배차간격. 정보가 없으면 null"
          },
          "sunday": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeadwayRangeResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "일요일 배차간격. 정보가 없으면 null"
          },
          "holiday": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HeadwayRangeResponse"
              },
              {
                "type": "null"
              }
            ],
            "description": "공휴일 배차간격. 정보가 없으면 null이며 일요일 값으로 대신하지 않는다"
          }
        },
        "required": [
          "holiday",
          "saturday",
          "sunday",
          "weekday"
        ]
      },
      "HeadwayRangeResponse": {
        "type": "object",
        "properties": {
          "minMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "최소 배차간격(분)",
            "maximum": 1440,
            "minimum": 1
          },
          "maxMinutes": {
            "type": "integer",
            "format": "int32",
            "description": "최대 배차간격(분). minMinutes와 같거나 크다",
            "maximum": 1440,
            "minimum": 1
          }
        },
        "required": [
          "maxMinutes",
          "minMinutes"
        ]
      },
      "DirectionInfoResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "UP 또는 DOWN",
            "enum": [
              "UP",
              "DOWN"
            ]
          },
          "name": {
            "type": "string",
            "description": "화면에 표시할 방향 이름"
          },
          "originStopName": {
            "type": "string",
            "description": "이 방향의 기점 정류장 이름"
          },
          "terminalStopName": {
            "type": "string",
            "description": "이 방향의 종점 정류장 이름"
          },
          "firstDepartureTime": {
            "type": "string",
            "description": "첫차 시각. HH:mm 형식"
          },
          "lastDepartureTime": {
            "type": "string",
            "description": "막차 시각. HH:mm 형식"
          }
        },
        "required": [
          "firstDepartureTime",
          "id",
          "lastDepartureTime",
          "name",
          "originStopName",
          "terminalStopName"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "안정적인 오류 코드",
            "enum": [
              "INVALID_ROUTE_ID",
              "ROUTE_NOT_FOUND",
              "STATION_NOT_FOUND",
              "REFERENCE_VERSION_CONFLICT",
              "MODEL_OUT_OF_SCOPE",
              "NO_RECENT_OBSERVATION",
              "SERVICE_UNAVAILABLE",
              "FAVORITE_GROUP_LIMIT_EXCEEDED",
              "FAVORITE_LIMIT_EXCEEDED",
              "INVALID_FAVORITE_GROUP_NAME",
              "FAVORITE_GROUP_NAME_CONFLICT",
              "FAVORITE_GROUP_NOT_FOUND",
              "LAST_FAVORITE_GROUP",
              "INVALID_FAVORITE_ORDER",
              "FAVORITE_TARGET_AMBIGUOUS",
              "FAVORITE_TARGET_UNAVAILABLE",
              "INVALID_REQUEST",
              "ENDPOINT_NOT_FOUND",
              "METHOD_NOT_ALLOWED",
              "INTERNAL_ERROR",
              "UNAUTHENTICATED",
              "CSRF_REJECTED",
              "NICKNAME_LENGTH",
              "NICKNAME_CHARACTERS",
              "NICKNAME_RESERVED",
              "NICKNAME_TAKEN",
              "REAUTH_REQUIRED"
            ]
          },
          "message": {
            "type": "string",
            "description": "사람이 읽는 설명. 클라이언트 분기는 code를 사용"
          },
          "requestId": {
            "type": "string",
            "description": "응답 헤더의 X-Request-Id 및 서버 로그와 대응하는 요청 식별자"
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ExactSeat": {
        "type": "object",
        "properties": {
          "remaining": {
            "type": "integer",
            "format": "int32",
            "description": "잔여 좌석 수",
            "minimum": 0
          },
          "kind": {
            "type": "string",
            "description": "EXACT",
            "enum": [
              "EXACT"
            ]
          }
        },
        "required": [
          "kind",
          "remaining"
        ],
        "title": "EXACT 좌석"
      },
      "ForecastResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "AVAILABLE 또는 UNAVAILABLE",
            "enum": [
              "AVAILABLE",
              "UNAVAILABLE"
            ]
          },
          "seatAvailableProbability": {
            "type": "number",
            "format": "double",
            "description": "좌석 이용 가능 확률. 0~1; UNAVAILABLE이면 필드 생략",
            "maximum": 1,
            "minimum": 0
          },
          "expectedSeats": {
            "type": "number",
            "format": "double",
            "description": "기대 잔여 좌석 수. 값이 없거나 UNAVAILABLE이면 필드 생략",
            "minimum": 0
          }
        },
        "required": [
          "status"
        ]
      },
      "WatchBoardResponse": {
        "type": "object",
        "properties": {
          "route": {
            "$ref": "#/components/schemas/BoardRouteResponse",
            "description": "노선과 현재 판본의 방향 정보"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time",
            "description": "응답 전체가 기준으로 사용한 관측 시각. 정류장 예보와 차량 위치가 모두 이 관측에서 나온다"
          },
          "staleAt": {
            "type": "string",
            "format": "date-time",
            "description": "응답 전체의 만료 시각. 관측 후 5분, 관측 시각이 01~03시대면 10분"
          },
          "model": {
            "$ref": "#/components/schemas/ModelInfoResponse",
            "description": "정류장 예보에 연결된 모델 정보"
          },
          "vehiclesInService": {
            "type": "integer",
            "format": "int32",
            "description": "기준 관측에 기록된 운행 차량 수. 위치를 읽지 못한 차량이 있으면 vehicles의 길이보다 클 수 있다",
            "minimum": 0
          },
          "stops": {
            "type": "array",
